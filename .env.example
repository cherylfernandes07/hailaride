# HailARide — environment variables
# Copy to .env and fill in your values.
# Never commit .env to git.

# ── AWS credentials ─────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-2

# ── Mapbox (dashboard) ───────────────────────────────────────────────────────
VITE_MAPBOX_TOKEN=pk.your_mapbox_token

# ── Bedrock Guardrails (optional) ───────────────────────────────────────────
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=1

# ── DynamoDB Local (set automatically by docker-compose) ─────────────────────
# To use DynamoDB Local outside Docker: DYNAMODB_ENDPOINT=http://localhost:8000
# To use real DynamoDB: DYNAMODB_TABLE=hailaride-rides (leave DYNAMODB_ENDPOINT unset)
DYNAMODB_TABLE=hailaride-rides
